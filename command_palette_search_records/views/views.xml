<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="res_config_settings_command_pallete_search_models" model="ir.ui.view">
        <field name="name">res_config_settings_command_pallete_search_models</field>
        <field name="model">res.config.settings</field>
        <field name="inherit_id" ref="base_setup.res_config_settings_view_form"/>
        <field name="arch" type="xml">
            <xpath expr="//div[@id = 'companies']/block" position="inside">
                <setting id="search_model_ids" help="Select Models To Direct Search.">
                    <field name="search_model_ids" widget="many2many_tags" options="{'no_create': True, 'no_edit': True,'no_open': True, 'no_quick_create': True}"/>
                </setting>
            </xpath>
        </field>
    </record>
</odoo>
